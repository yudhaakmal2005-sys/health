# Salin menjadi deploy/.env lalu isi. JANGAN commit file .env.

# Domain yang A record-nya mengarah ke IP VPS (contoh: sehati.desaanda.id)
DOMAIN=sehati.example.id

# Kata sandi basis data (acak, panjang). Buat dengan: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-acak
# Harus memakai kata sandi yang sama dengan POSTGRES_PASSWORD di atas
DATABASE_URL=postgres://sehati:ganti-dengan-kata-sandi-acak@db:5432/sehati

# Admin Puskesmas pertama (dibuat otomatis saat start pertama bila belum ada admin)
ADMIN_ID=AD-000001
# Wajib, minimal 10 karakter. Ganti setelah masuk pertama kali.
ADMIN_PASSWORD=ganti-kata-sandi-admin

# Tanya SEHATI (AI). Kosongkan untuk menonaktifkan AI (aplikasi tetap berjalan, AI → 503 AI_DISABLED).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low = jawaban chat singkat & hemat; medium/high = lebih teliti tetapi lebih mahal
AI_EFFORT=low

# Origin dashboard web (boleh beberapa, pisahkan koma). Biasanya https://<DOMAIN>
CORS_ORIGIN=https://sehati.example.id

TZ=Asia/Jakarta
LOG_LEVEL=info
