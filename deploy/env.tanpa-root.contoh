# Salin/ubah nama file ini menjadi ".env" (di folder yang sama), lalu isi.
# JANGAN bagikan isi file .env ke siapa pun.

NODE_ENV=production

# Alamat basis data PostgreSQL. Contoh cPanel:
#   postgres://NAMAUSER_sehati:KATASANDI@localhost:5432/NAMAUSER_sehati
# Contoh layanan gratis (Neon/Supabase) — salin "connection string" dari dasbornya, akhiri ?sslmode=require
DATABASE_URL=postgres://USER:KATASANDI@localhost:5432/NAMADB

# Admin Puskesmas pertama (dibuat otomatis saat pertama jalan). Kata sandi minimal 10 karakter.
ADMIN_ID=AD-000001
ADMIN_PASSWORD=ganti-kata-sandi-admin

# Dashboard web disajikan langsung oleh aplikasi ini (folder public).
WEB_DIR=public
# Alamat situs Anda (untuk keamanan CORS)
CORS_ORIGIN=https://sehati.akademiforex.com

# ---- Tanya SEHATI (AI) — boleh dikosongkan dulu; fitur lain tetap jalan ----
# Penyedia berformat OpenAI (OpenAI / DeepSeek / Gemini / Groq / OpenRouter):
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Contoh lain:
#   DeepSeek : AI_BASE_URL=https://api.deepseek.com/v1                          AI_MODEL=deepseek-chat
#   Gemini   : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=gemini-2.5-flash
#   Groq     : AI_BASE_URL=https://api.groq.com/openai/v1                        AI_MODEL=llama-3.3-70b-versatile

TZ=Asia/Jakarta
LOG_LEVEL=info
